{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile metadata and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isGuest": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "isGuest"]
    },
    "SavedScan": {
      "title": "SavedScan",
      "description": "Saved scam scan report for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "number" },
        "analysisType": { "type": "string" },
        "titleSnippet": { "type": "string" },
        "riskScore": { "type": "number" },
        "riskLevel": { "type": "string" },
        "scamType": { "type": "string" },
        "summary": { "type": "string" },
        "suggestedReply": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "timestamp", "riskScore", "riskLevel"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": "SavedScan",
      "description": "Saved scan documents for the given user"
    }
  }
}
